{
  "name": "novawerk",
  "version": "0.0.0",
  "private": true,
  "description": "Novawerk monorepo: public website, admin panel, API, agents, knowledge base and internal records.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nw/db db:generate",
    "db:migrate": "pnpm --filter @nw/db db:migrate",
    "db:studio": "pnpm --filter @nw/db db:studio",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:seed:dev": "docker compose exec -T db mkdir -p /seed && docker compose cp packages/db/seed.sql db:/seed/seed.sql && docker compose cp packages/db/seed.dev.sql db:/seed/seed.dev.sql && docker compose exec -T db psql -U novawerk -d novawerk -v ON_ERROR_STOP=1 -f /seed/seed.dev.sql",
    "agent": "tsx agents/run.ts",
    "video": "pnpm --dir videos video",
    "new:agent": "tsx scripts/new-agent.ts",
    "new:record": "tsx scripts/new-record.ts",
    "post": "tsx scripts/post.ts",
    "provision:member": "tsx scripts/provision-member.ts",
    "backup": "bash scripts/backup.sh",
    "demo:pipeline": "tsx scripts/demo-pipeline.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

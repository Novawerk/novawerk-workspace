# Novawerk — secrets manifest (names only; never commit real values). For the agents and scripts;
# running the apps locally needs none of it: see apps/*/.env.example and CONTRIBUTING.md.
# Copy to `.env` (gitignored) for local runs. In production the agents get these as GitHub
# Actions repository secrets — each workflow passes only the ones its agent declares (see
# `pnpm agent <id> --help`). `packages/config` is the only shared module that reads them, and it
# fails fast with the full list of what's missing.

# --- Anthropic (Claude) — intake, sponsor-*, standup-digest, all-hands-prep ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Jira (novawerk-teams.atlassian.net, project NB, board 34) — standup-digest, all-hands-prep, jira-automation ---
JIRA_BASE_URL=https://novawerk-teams.atlassian.net
JIRA_EMAIL=you@novawerk.io
JIRA_API_TOKEN=ATATTxxxxxxxxxxxxxxxxxxxx

# --- Email (Resend). Used ONLY where a member approves outbox emails (the admin API) and by
# notifyTeam(). Agent workflows never get these, so an agent cannot send email. ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Novawerk <info@novawerk.io>

# --- Postgres (Neon). Everything that changes: members, submissions, partners, ledger, outbox. ---
DATABASE_URL=postgres://nw:password@localhost:5432/novawerk

# --- Vercel Blob (files: project images public, documents private) ---
# Production's stores: only where production runs. Locally, leave them empty (uploads go to .local-files/).
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# --- GitHub App novawerk-task-board — contributor sign-in on the API only (never an agent) ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The same App on our repository (comments, labels) and its webhook secret — the API only.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

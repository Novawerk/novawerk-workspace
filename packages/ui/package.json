{
  "name": "@nw/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI for Novawerk apps: shadcn base-vega components (core), our composites (compound) and Vercel AI Elements.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./styles/*": "./src/styles/*",
    "./lib/*": "./src/lib/*.ts",
    "./core/components/ui/*": "./src/core/components/ui/*.tsx",
    "./core/hooks/*": "./src/core/hooks/*.ts",
    "./compound/*": "./src/compound/*.tsx",
    "./ai-elements/*": "./src/ai-elements/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "shadcn": "^4.21.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}

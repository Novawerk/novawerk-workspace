{
  "name": "@nw/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Novawerk's agents. One folder per agent; GitHub Actions runs them with `pnpm agent <id>`.",
  "scripts": {
    "agent": "tsx run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nw/agent-core": "workspace:*",
    "@nw/ceremonies": "workspace:*",
    "@nw/config": "workspace:*",
    "@nw/db": "workspace:*",
    "@nw/intake": "workspace:*",
    "@nw/jira": "workspace:*",
    "@nw/kb": "workspace:*",
    "@nw/partners": "workspace:*",
    "@nw/promo": "workspace:*",
    "@nw/records": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}

# apps/web — copy to .env.local (ignored) for local dev. Real values live in Vercel.

# Server-side base URL of apps/api (wherever it runs locally), used for GET /public/projects and
# the task board's reads (/public/tasks, /public/contributors, /public/blocks, /public/initiators).
# Unset or unreachable → the built-in fallback projects, and the board says it's offline.
API_URL=http://localhost:8787

# Browser-side base URL of apps/api, used by the forms (POST /public/submissions, /public/subscribe)
# and by the task board in the browser (sign-in, /contrib/*, filtered lists).
# Inlined at build time. Unset → forms show the "couldn't send" message.
NEXT_PUBLIC_API_URL=http://localhost:8787

# OAuth client id for "Continue with Google" on /sign-in and in Settings: the same client as the
# admin panel's VITE_GOOGLE_CLIENT_ID, with this site's origins allowed in Google Cloud.
# Inlined at build time. Unset → no Google button (GitHub and email codes still work).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Our other apps: where a sign-in may send people back to, and the links in Settings.
# Defaults: https://admin.novawerk.io and https://chat.novawerk.io. Locally the admin runs here; the
# chat has no local copy (apps/chat is deployed apart), so its link stays production's.
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173
# NEXT_PUBLIC_CHAT_URL=

# Shared secret for POST /api/revalidate (header: x-revalidate-secret).
# The API sends it after a change to mark cache tags stale (`projects`, `tasks`, `contributors`).
REVALIDATE_SECRET=change-me

# Server-only key for the task board's reads (header: x-nw-web-key). The same value as the API's
# WEB_READ_KEY, 32+ characters; with it the website's servers skip the API's anonymous limit.
# Never NEXT_PUBLIC_. Unset → reads count as anonymous (fine locally).
# WEB_READ_KEY=

# Optional: absolute path to the monorepo's knowledge/ folder, if it can't be found by
# walking up from the working directory.
# NW_KNOWLEDGE_DIR=/absolute/path/to/knowledge

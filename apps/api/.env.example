# @nw/api — copy to apps/api/.env for local dev (gitignored). In production these are
# Vercel project env vars. Only src/index.ts and src/server.ts read them.

# Required
DATABASE_URL=
GOOGLE_CLIENT_ID=
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Optional (defaults in src/deps.ts)
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
# Comma-separated. Public routes (/health, /public/*)
ALLOWED_ORIGINS=
# Comma-separated. Credentialed routes (/auth/*, /admin/*)
ADMIN_ORIGINS=
# The website's server sends it as x-nw-web-key on task board reads, exempt from the anonymous
# per-network limit (600/h). 32+ characters; the same value as the web's WEB_READ_KEY.
WEB_READ_KEY=
# Comma-separated. The website, with the contributor cookie (/auth/contributor/*, /contrib/*).
# Default: the origins in ALLOWED_ORIGINS that aren't in ADMIN_ORIGINS.
CONTRIBUTOR_ORIGINS=
# Where newsletter links point (defaults https://api.novawerk.io and https://novawerk.io).
# Locally: http://localhost:8787 and http://localhost:3000.
PUBLIC_API_URL=
PUBLIC_WEB_URL=
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# Claude. Runs the intake agent right after a form lands, and the promo agent after a project's
# status changes or a member asks for a post draft, here in the API (src/agents.ts); without it,
# the agents' GitHub Actions crons pick the work up later. It is also the key for the chats below.
ANTHROPIC_API_KEY=
PORT=
# The chats: the intake chat (/public/intake/*), the admin assistant and the post writer. Without a
# key they answer 503 and the rest of the API still works.
# LLM_PROVIDER: anthropic (default, ANTHROPIC_API_KEY) | openai-compatible | mock (no key, scripted demo).
LLM_PROVIDER=
# openai-compatible needs all three; for anthropic LLM_MODEL overrides the default
# (claude-sonnet-5-5). LLM_API_KEY is also the fallback key for anthropic.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=
# Visitor messages per chat (default 40) and new chats per IP per hour (default 20, per instance).
INTAKE_MAX_TURNS=
INTAKE_SESSIONS_PER_HOUR=
# Vercel Blob file stores (project images public, documents private). Set on Vercel when the
# stores are connected to novawerk-api; locally `vercel env pull`. Without them uploads answer 503.
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Vercel Cron's bearer token for /cron/* (the daily chat cleanup). At least 16 characters.
# Unset: the /cron routes answer 404.
CRON_SECRET=
# info@ mail in Slack (POST /webhooks/resend). All three or none; without them the route answers
# 404. The webhook's signing secret (whsec_…), a full-access Resend key (reading a received
# email needs one; keep it apart from RESEND_API_KEY), and the channel's Slack incoming webhook.
RESEND_WEBHOOK_SECRET=
RESEND_RECEIVING_API_KEY=
SLACK_INBOX_WEBHOOK_URL=
# Only mail with this List-ID is posted. Default info.novawerk.io (the Google group).
INBOUND_LIST_ID=
# Contributor sign-in with GitHub: the GitHub App novawerk-task-board (Settings → Developer
# settings → GitHub Apps). Both or neither; without them /auth/contributor/github/* answer 503 and
# contributors sign in with an emailed code. The callback is PUBLIC_API_URL +
# /auth/contributor/github/callback, so locally set PUBLIC_API_URL=http://localhost:8787.
# Real values live in Vercel env, never here.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The same App acting on our repository: comments and size labels on pull requests, and the
# nightly reconcile (/cron/github-sync). All three or none. The private key is the PEM from the App
# settings (a one-line value with \n works). Without them tasks still move, but nothing is said on GitHub.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# The App's webhook secret (16+ characters). Unset: POST /webhooks/github answers 404.
GITHUB_WEBHOOK_SECRET=
# Local development only: enables POST /auth/dev so the admin panel can sign in without Google.
# Refused on Vercel / NODE_ENV=production.
DEV_LOGIN=

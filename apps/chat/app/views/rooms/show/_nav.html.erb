<% content_for :nav do %>
  <h1 class="nw-hdr-title room--current">
    <% if room.direct? %>
      <span class="for-screen-reader">Ping with</span>
    <% else %>
      <%= image_tag(room.is_a?(Rooms::Closed) ? "lock.svg" : "hash.svg", class: "nw-muted") %>
    <% end %>
    <span class="room__contents"><%= room_display_name(room) %></span>
  </h1>

  <span class="nw-hdr-sub nw-hdr-sub--phone"><%= room.direct? ? "Direct message" : pluralize(room.users.active.count, "member") %></span>

  <span class="nw-hdr-sub">
    <%= room.direct? ? "Direct message" : (room.is_a?(Rooms::Closed) ? "Closed room · #{pluralize(room.users.size, "member")}" : "Open room · everyone in #{Current.account.name}") %>
  </span>

  <% unless room.direct? %>
    <% members = room.users.active.ordered.limit(3) %>
    <%= link_to room_members_path(room), class: "btn nw-hdr-members", title: "Members" do %>
      <span class="nw-stack-avatars">
        <% members.each do |member| %>
          <span class="avatar"><%= image_tag fresh_user_avatar_path(member), size: 20, alt: "" %></span>
        <% end %>
      </span>
      <span class="nw-hdr-count"><%= room.users.active.count %></span>
      <span class="for-screen-reader">Members</span>
    <% end %>
  <% end %>

  <%= render "rooms/involvements/bell", room: room %>

  <details class="nw-hdr-menu" data-controller="popup" data-action="keydown.esc->popup#close toggle->popup#toggle click@document->popup#closeOnClickOutside">
    <summary class="btn" title="Room menu"><%= image_tag "menu-dots-horizontal.svg" %><span class="for-screen-reader">Room menu</span></summary>
    <div class="nw-menu nw-hdr-menu__menu" data-popup-target="menu">
      <% if Current.user.can_administer?(room) %>
        <%= link_to [ :edit, room ], class: "nw-menu__item" do %><%= image_tag "settings.svg" %><span><%= room.direct? ? "Conversation settings" : "Room settings" %></span><% end %>
      <% end %>
      <% unless room.direct? %>
        <%= link_to room_members_path(room), class: "nw-menu__item" do %><%= image_tag "users.svg" %><span>Members</span><span class="nw-menu__short"><%= room.users.active.count %></span><% end %>
      <% end %>
      <button type="button" class="nw-menu__item" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy popup#close"
          data-copy-to-clipboard-success-class="btn--success" data-copy-to-clipboard-content-value="<%= room_url(room) %>">
        <%= image_tag "link.svg" %><span>Copy room link</span>
      </button>
      <% if Current.user.can_administer?(room) && !room.direct? %>
        <div class="nw-menu__sep"></div>
        <%= button_to room_path(room), method: :delete, class: "nw-menu__item nw-menu__item--danger btn--negative", form_class: "nw-menu__form",
              data: { turbo_confirm: "Delete ##{room.name} and every message in it? This can't be undone.", confirm_label: "Delete room" } do %>
          <%= image_tag "trash.svg" %><span>Delete room…</span>
        <% end %>
      <% end %>
    </div>
  </details>
<% end %>

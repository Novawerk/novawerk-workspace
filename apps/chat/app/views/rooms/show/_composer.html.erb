<% content_for :footer do %>
  <div class="composer flex align-end gap position-relative"
      data-controller="typing-notifications" data-typing-notifications-active-class="typing-indicator--active">

    <turbo-frame id="composer-frame">
      <%= composer_form_tag(room) do |form| %>
        <fieldset data-composer-target="fields" contents>
          <div class="flex flex-column">
            <div class="nw-reply-bar" data-composer-target="replyBar" hidden>
              <%= image_tag "reply.svg" %><span>Replying to <strong data-composer-target="replyName"></strong></span>
              <button type="button" class="nw-reply-bar__cancel" data-action="composer#cancelReply" title="Cancel reply" aria-label="Cancel reply"><%= image_tag "remove.svg" %></button>
            </div>

            <div class="composer__input nw-composer">
              <%# Novawerk Chat: picked files are chips inside the composer (RoomStates · G). %>
              <div class="nw-composer__files" data-composer-target="fileList"></div>
              <div class="nw-composer__editor">
                <%= form.rich_text_area :body,
                      rows: 1,
                      class: "input lexxy-content",
                      placeholder: room.direct? ? "Message #{room_display_name(room)}" : "Message ##{room.name}",
                      aria: { multiline: "true", label: "Write a message" },
                      "permitted-attachment-types": "application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed",
                      data: {
                        controller: "unfurl",
                        action: "#{rich_text_data_actions} lexxy:change->composer#saveDraft lexxy:insert-link->unfurl#unfurl",
                        composer_target: "text" } do %>
                  <%= mention_prompt_tag room %>
                <% end %>
              </div>

              <div class="nw-composer__actions" data-controller="nw-insert">
                <label class="btn btn--borderless composer__attachment-btn input--file" title="Attach a file">
                  <%= image_tag "attachment.svg", class: "nw-desktop-only" %>
                  <%= image_tag "add.svg", class: "nw-phone-only", size: 20 %>
                  <input type="file" data-action="composer#filePicked" multiple />
                  <span class="for-screen-reader">Attach a file</span>
                </label>

                <button class="btn btn--borderless" type="button" title="Mention someone" data-action="nw-insert#insert" data-nw-insert-text-param="@">
                  <%= image_tag "at-sign.svg" %>
                  <span class="for-screen-reader">Mention someone</span>
                </button>

                <details class="nw-emoji" data-controller="popup" data-action="keydown.esc->popup#close toggle->popup#toggle click@document->popup#closeOnClickOutside">
                  <summary class="btn btn--borderless" title="Emoji">
                    <%= image_tag "smile-plus.svg" %>
                    <span class="for-screen-reader">Emoji</span>
                  </summary>
                  <div class="nw-emoji__menu nw-menu" data-popup-target="menu" data-controller="nw-filter">
                    <label class="input nw-input-group nw-emoji__search">
                      <%= image_tag "search.svg", class: "nw-muted" %>
                      <input type="search" placeholder="Search emoji" aria-label="Search emoji" autocomplete="off" data-action="input->nw-filter#filter">
                    </label>
                    <div class="nw-emoji__grid">
                      <% EmojiHelper::PICKER.each do |character, words| %>
                        <button type="button" class="nw-emoji__btn" title="<%= words.split.first %>" data-nw-filter-target="item" data-nw-filter-text="<%= "#{words} #{character}".downcase %>"
                            data-action="nw-insert#insert popup#close" data-nw-insert-text-param="<%= character %>"><%= character %></button>
                      <% end %>
                    </div>
                  </div>
                </details>

                <button class="btn btn--borderless composer__rich-text-btn" type="button" title="Formatting" aria-pressed="false" data-action="composer#toggleToolbar">
                  <%= image_tag "text-options.svg" %>
                  <span class="for-screen-reader">Formatting</span>
                </button>

                <span class="nw-composer__hint"><span class="nw-composer__hint-plain">Enter to send · Shift+Enter for a new line</span><span class="nw-composer__hint-block">⌘Enter to send · Enter for a new line</span></span>

                <%= form.button name: "send", type: "submit", data: { action: "composer#submit" }, class: "btn nw-composer__send", title: "Send message" do %>
                  <%= image_tag "arrow-up.svg" %>
                  <span class="for-screen-reader">Send Message</span>
                <% end %>
              </div>
            </div>
          </div>
        </fieldset>

        <div class="typing-indicator gap txt-small align-center flex-inline" data-typing-notifications-target="indicator">
          <div class="typing-indicator__author spinner" data-typing-notifications-target="author"></div>
        </div>

        <%= form.hidden_field :client_message_id, data: { composer_target: "clientid" } %>
      <% end %>
    </turbo-frame>
  </div>
<% end %>

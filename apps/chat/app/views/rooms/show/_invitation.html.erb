<%# Novawerk Chat: the start of a room is an intro, not a card with a raw join link (that stays in
    Account settings, and only without Novawerk sign-in). %>
<% if !room.direct? && !room.messages.paged? %>
  <div id="system_welcome" class="nw-intro">
    <span class="nw-intro__icon"><%= image_tag(room.is_a?(Rooms::Closed) ? "lock.svg" : "hash.svg", size: 24) %></span>
    <p class="nw-intro__title">Welcome to #<%= room.name %></p>
    <p class="nw-intro__text">
      <% if room.is_a?(Rooms::Closed) %>
        This is the start of #<%= room.name %>. Only its members can see it.
      <% else %>
        This is the start of #<%= room.name %>. Everyone with a Novawerk account is here, and new members join it automatically.
      <% end %>
    </p>
    <div class="nw-intro__actions">
      <%= link_to [ :edit, room ], class: "btn nw-btn-outline nw-btn-sm" do %>
        <%= image_tag "users.svg" %><span>Members</span>
      <% end %>
      <%= link_to user_profile_path, class: "btn nw-btn-outline nw-btn-sm" do %>
        <%= image_tag "notification-bell-everything.svg" %><span>Notifications</span>
      <% end %>
    </div>
  </div>
<% end %>

<%# Novawerk Chat: the start of a room is an intro, not a card with a raw join link (that stays in
    Account settings, and only without Novawerk sign-in). %>
<% if !room.direct? && !room.messages.paged? %>
  <div id="system_welcome" class="nw-intro">
    <span class="nw-intro__icon"><%= image_tag(room.is_a?(Rooms::Closed) ? "lock.svg" : "hash.svg", size: 24) %></span>
    <p class="nw-intro__title">Welcome to #<%= room.name %></p>
    <p class="nw-intro__text">
      <% if room.is_a?(Rooms::Closed) %>
        This is the start of #<%= room.name %>. Only its members can see it.
      <% else %>
        This is the start of #<%= room.name %>. Everyone with a Novawerk account is here, and new members join it automatically.
      <% end %>
    </p>
    <div class="nw-intro__actions">
      <%= link_to room_members_path(room), class: "btn nw-btn-outline nw-btn-sm" do %>
        <%= image_tag "users.svg" %><span>Members</span>
      <% end %>
      <%= link_to user_profile_path, class: "btn nw-btn-outline nw-btn-sm" do %>
        <%= image_tag "notification-bell-everything.svg" %><span>Notifications</span>
      <% end %>
    </div>
  </div>
<% end %>

<%# A direct message starts with the people in it, like a room starts with its intro. %>
<% if room.direct? && !room.messages.paged? %>
  <% others = room.users.without(Current.user).active.ordered.to_a %>
  <div id="system_welcome" class="nw-intro nw-intro--direct">
    <span class="nw-intro__avatars">
      <% (others.presence || [ Current.user ]).first(3).each do |user| %>
        <span class="avatar"><%= image_tag fresh_user_avatar_path(user), alt: "", size: 48 %></span>
      <% end %>
    </span>
    <p class="nw-intro__title"><%= room_display_name(room) %></p>
    <p class="nw-intro__text">
      <% if others.empty? %>
        This is your own space. Jot down notes or drafts; nobody else sees them.
      <% else %>
        This is the start of your conversation with <%= others.map(&:name).to_sentence %>. Only you<%= others.one? ? " two" : "" %> can see it.
      <% end %>
    </p>
    <% if others.one? %>
      <div class="nw-intro__actions">
        <%= link_to user_path(others.first), class: "btn nw-btn-outline nw-btn-sm" do %>
          <%= image_tag "person.svg" %><span>View profile</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

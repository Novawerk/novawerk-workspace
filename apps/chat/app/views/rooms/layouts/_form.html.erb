<%= form_with model: room do |form| %>
  <div class="nw-room-form__body">
    <% if Current.user.can_administer?(room) %>
      <div class="nw-field">
        <label class="nw-label" for="room_name">Name</label>
        <span class="input nw-input-group nw-input-group--lg">
          <%= image_tag "hash.svg", class: "nw-muted" %>
          <%= form.text_field :name, name: "room[name]", id: "room_name",
                required: true, autofocus: true, placeholder: "design-crit",
                data: { turbo_permanent: true, action: "keydown.enter->form#submit:prevent" } %>
        </span>
        <span class="nw-hint">Short and lowercase works best, like "task-board".</span>
      </div>
    <% else %>
      <h3 class="nw-card__title">#<%= room.name %></h3>
    <% end %>

    <%= yield %>
  </div>

  <% if Current.user.can_administer?(room) %>
    <div class="nw-card__foot">
      <%= link_to "Cancel", (room.persisted? ? room_path(room) : root_path), class: "btn nw-btn-outline" %>
      <%= submit_room_button_tag(room) %>
    </div>
  <% end %>
<% end %>

<% @page_title = "Edit settings for #{room.name}" %>
<% page_header "Settings", crumb: (room.direct? ? room_display_name(room) : "##{room.name}") %>
<% content_for :head do %><meta name="current-room-id" content="<%= room.id %>"><% end %>

<div class="nw-page">
  <div class="nw-page__narrow nw-page__narrow--form">
    <div class="nw-page__intro">
      <h2 class="nw-h1">Room settings</h2>
      <p class="nw-lead">Created<%= " by #{room.creator.name}" if room.creator %> on <%= room.created_at.strftime("%-d %b %Y") %>.</p>
    </div>
    <div class="nw-card nw-room-form" style="view-transition-name: edit-room-<%= room.id %>">
      <%= yield %>
    </div>

    <% if Current.user.can_administer?(@room) %>
      <div class="nw-card nw-card--danger">
        <div class="nw-card__head"><h3 class="nw-card__title">Delete this room</h3><p class="nw-card__desc">Removes #<%= room.name %> and all its messages for everyone. This can't be undone.</p></div>
        <div class="nw-card__body nw-card__body--tight"><%= button_to_delete_room room %></div>
      </div>
    <% end %>
  </div>
</div>

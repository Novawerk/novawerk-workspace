<%# Novawerk Chat: the bell opens "Notify me about" (RoomStates · E) instead of cycling through levels,
    and its icon shows the level (bell, @, bell-off). Clicking it still asks the browser for push
    permission the first time. %>
<% involvement = Current.user.memberships.find_by(room: room)&.involvement || "mentions" %>

<span class="button_to_change_notifying"
    data-controller="notifications" data-notifications-subscriptions-url-value="<%= user_push_subscriptions_path %>" data-notifications-attention-class="btn--pulsing">
  <details class="nw-hdr-menu" data-controller="popup" data-action="keydown.esc->popup#close toggle->popup#toggle click@document->popup#closeOnClickOutside">
    <summary class="btn" title="Notifications" data-notifications-target="bell" data-action="click->notifications#attemptToSubscribe">
      <%= image_tag "notification-bell-#{involvement == "invisible" ? "nothing" : involvement}.svg" %>
      <%= image_tag "notification-bell-alert.svg", hidden: true %>
      <span class="for-screen-reader">Notification settings for this <%= room.direct? ? "conversation" : "room" %></span>
    </summary>

    <div class="nw-menu nw-hdr-menu__menu nw-hdr-menu__menu--wide" data-popup-target="menu">
      <div data-notifications-target="blocked" hidden>
        <button type="button" class="nw-menu__item nw-menu__item--tall nw-menu__item--warning" data-action="notifications#showBlockedNotice">
          <%= image_tag "notification-bell-nothing.svg" %>
          <span class="nw-stack"><span class="nw-menu__title">Notifications are off</span><span class="nw-small nw-muted">Blocked by this browser. Fix…</span></span>
        </button>
        <div class="nw-menu__sep"></div>
      </div>
      <%= render "rooms/involvements/levels", room: room, involvement: involvement, return_to: :room %>
    </div>
  </details>

  <dialog data-notifications-target="notAllowedNotice" class="nw-dialog nw-notice-dialog">
    <div class="nw-notice-dialog__head">
      <span class="nw-notice-dialog__icon"><%= image_tag "notification-bell-nothing.svg", size: 20 %></span>
      <div class="nw-stack">
        <h2 class="nw-notice-dialog__title">Notifications are off</h2>
        <p class="nw-muted">Your browser is blocking them for <%= request.host %>.</p>
      </div>
    </div>
    <ol class="nw-notice-dialog__steps">
      <li>Click the icon left of the address bar.</li>
      <li>Set <b>Notifications</b> to <b>Allow</b>.</li>
      <li>Also check your system settings let the browser notify.</li>
    </ol>
    <form method="dialog" class="nw-dialog__actions">
      <button class="btn nw-btn-outline nw-btn-sm" value="close">Not now</button>
      <button class="btn btn--reversed nw-btn-sm" value="retry" data-action="notifications#attemptToSubscribe">Try again</button>
    </form>
  </dialog>
</span>

<% @page_title = "New direct message" %>
<% page_header "New message", crumb: "Direct messages" %>

<%# Novawerk Chat: a page (New direct message board), not a picker squeezed into the sidebar. %>
<div class="nw-page">
  <div class="nw-page__narrow nw-page__narrow--form">
    <div class="nw-page__intro">
      <h2 class="nw-h1">New direct message</h2>
      <p class="nw-lead">Pick one person, or a few for a small group.</p>
    </div>

    <div class="nw-card nw-room-form">
      <%= form_with model: @room, data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
        <div class="nw-room-form__body">
          <div class="nw-dm-to autocomplete__container" data-controller="autocomplete" data-autocomplete-url-value="<%= autocompletable_users_path %>">
            <span class="nw-dm-to__label">To</span>
            <div class="autocomplete__input nw-dm-to__field">
              <select name="user_ids[]" data-autocomplete-target="select" data-template-id="autocompletable-user" multiple="true" hidden required></select>
              <%= render "users/autocompletables/template" %>
              <%= form.text_field "user_ids_input", autocomplete: "off", autocorrect: "off", "data-1p-ignore": "true", autofocus: true,
                    placeholder: "Type a name", class: "nw-dm-to__input",
                    data: { autocomplete_target: "input", action: "input->autocomplete#search keydown->autocomplete#didPressKey" } %>
            </div>
          </div>
          <span class="nw-hint">Type to find people, then press Enter to add them.</span>
        </div>

        <div class="nw-card__foot">
          <%= link_to "Cancel", (last_room_visited ? room_path(last_room_visited) : root_path), class: "btn nw-btn-outline" %>
          <%= button_tag type: "submit", class: "btn btn--reversed" do %><%= image_tag "messages.svg" %><span>Start conversation</span><% end %>
        </div>
      <% end %>
    </div>

    <% recent = Current.user.memberships.joins(:room).merge(Room.directs).order("rooms.updated_at DESC").limit(4).map(&:room) %>
    <% if recent.any? %>
      <div class="nw-dm-recent">
        <span class="nw-small nw-muted">Recent</span>
        <div class="nw-row">
          <% recent.each do |room| %>
            <% other = room.users.without(Current.user).first || Current.user %>
            <%= link_to room_path(room), class: "nw-chip nw-chip--person" do %>
              <%= image_tag fresh_user_avatar_path(other), alt: "", size: 16 %><span><%= room_display_name(room) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

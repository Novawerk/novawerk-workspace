<li class="nw-picker__row" data-value="<%= [ user.name, user.novawerk_handle ].compact.join(" ").downcase %>">
  <% if Current.user.can_administer?(room) %>
    <% if user == Current.user && room.new_record? %>
      <%= hidden_field_tag "user_ids[]", user.id, id: nil %>
      <input type="checkbox" class="nw-check" checked disabled aria-label="You">
    <% else %>
      <%= check_box_tag "user_ids[]", user.id, selected, class: "nw-check", id: nil, aria: { label: "Give #{user.name} access to this room" } %>
    <% end %>
  <% end %>
  <span class="avatar"><%= image_tag fresh_user_avatar_path(user), alt: "", size: 24, loading: :lazy %></span>
  <span class="nw-picker__name"><%= user.name %></span>
  <% if user.novawerk_handle.present? %><span class="nw-small nw-muted">@<%= user.novawerk_handle %></span><% end %>
  <% if user == Current.user %>
    <span class="nw-badge">You</span>
  <% elsif user.administrator? %>
    <span class="nw-badge nw-badge--soft">Maintainer</span>
  <% end %>
</li>

<%= render layout: "rooms/layouts/form", locals: { room: room } do %>
  <% if Current.user.can_administer?(room) %>
    <%= render "rooms/access_choice", current_kind: :closed, type_change_path: type_change_path %>
  <% end %>

  <div class="nw-field" data-controller="filter nw-picker" data-filter-active-class="filter--active" data-filter-selected-class="selected">
    <div class="nw-picker__head">
      <span class="nw-label">Members</span>
      <span class="nw-small nw-muted"><span data-nw-picker-target="count"><%= selected_users.size + (room.new_record? ? 1 : 0) %></span> of <%= selected_users.size + unselected_users.size %> picked</span>
    </div>
    <div class="nw-picker">
      <div class="nw-picker__tools">
        <span class="input nw-input-group">
          <%= image_tag "search.svg", class: "nw-muted" %>
          <input type="search" placeholder="Search people" aria-label="Search people" autocomplete="off" data-action="input->filter#filter">
        </span>
        <% if Current.user.can_administer?(room) %>
          <button type="button" class="btn nw-btn-outline nw-btn-sm" data-action="nw-picker#selectAll"><%= image_tag "check.svg" %><span>Select all</span></button>
        <% end %>
      </div>
      <menu class="nw-picker__list" data-filter-target="list" data-action="change->nw-picker#count">
        <%= render partial: "rooms/closeds/user", collection: selected_users, locals: { room: room, selected: true } %>
        <%= render partial: "rooms/closeds/user", collection: unselected_users, locals: { room: room, selected: false } %>
      </menu>
    </div>
  </div>
<% end %>

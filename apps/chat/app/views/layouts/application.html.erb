<!DOCTYPE html>
<html>
  <head>
    <%= page_title_tag %>

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#0a3920">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csp_meta_tag %>
    <%= current_user_meta_tags %>
    <%= script_aware_action_cable_meta_tag %>

    <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid.public_key %>
    <%= tag.meta name: "turbo-prefetch", content: "true" %>

    <%= tag.link rel: "manifest", href: webmanifest_path(format: :json) %>
    <%= tag.link rel: "icon", href: fresh_account_logo_path, type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: fresh_account_logo_path %>

    <%= stylesheet_link_tag :all, "data-turbo-track": "reload" %>
    <%= custom_styles_tag %>

    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body class="<%= body_classes %>" data-controller="local-time lightbox">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      <%= yield :nav %>
    </nav>

    <% if notice = flash[:notice] || flash[:alert] %>
      <%# Novawerk Chat: a toast with words (States board), not a bare green circle. %>
      <div class="flash nw-toast <%= "nw-toast--error" if flash[:alert] %> <%= "nw-toast--undo" if flash[:undo] %>" role="<%= flash[:alert] ? "alert" : "status" %>"
          data-controller="element-removal" data-action="animationend->element-removal#remove">
        <%= image_tag(flash[:alert] ? "alert.svg" : "circle-check.svg") %>
        <span><%= notice == "✓" ? "Saved" : notice %></span>
        <% if (undo = flash[:undo]).is_a?(Hash) && undo["url"].to_s.start_with?("/") %>
          <%= button_to "Undo", undo["url"], method: :put, params: { involvement: undo["involvement"], return_to_room: 1 },
                class: "nw-toast__undo", form_class: "nw-toast__form", data: { turbo_frame: "_top" } %>
        <% end %>
      </div>
    <% end %>

    <main id="main-content">
      <%= yield %>

      <footer id="footer">
        <%= yield :footer %>
      </footer>
    </main>

    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open" data-action="click@document->toggle-class#closeOnClickOutside keydown.esc@document->toggle-class#close">
      <%= content_for?(:sidebar) ? yield(:sidebar) : (sidebar_turbo_frame_tag(src: user_sidebar_path) if Current.user) %>
    </aside>

    <%= render "layouts/lightbox" %>

  </body>
</html>

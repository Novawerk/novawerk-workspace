<turbo-frame id="<%= dom_id(@message, :edit) %>">
  <div class="message__body position-relative" data-controller="scroll-into-view">
    <div class="message__body-content message__body-content--editing gap">
      <% if @message.content_type.attachment? %>
        <%= message_attachment_presentation(@message) %>

        <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
          <%= button_tag class: "btn btn--negative nw-btn-sm", type: "submit",
                form: dom_id(@message, :delete_form), data: { turbo_confirm: "Delete this file? This can't be undone.", confirm_label: "Delete" } do %>
            <%= image_tag "trash.svg" %><span>Delete</span>
          <% end %>
          <%= link_to "Cancel", room_message_path(@room, @message), class: "btn nw-btn-outline nw-btn-sm" %>
        </div>
      <% else %>
        <div class="nw-edit">
          <div class="message__meta nw-edit__meta">
            <span class="message__author"><strong><%= @message.creator.name %></strong></span>
            <span class="message__permalink"><%= local_datetime_tag(@message.created_at, style: :time) %></span>
            <span class="nw-badge nw-badge--outline">Editing</span>
          </div>
          <%= form_with model: @message, url: room_message_path(@room, @message), id: dom_id(@message, :form), data: {
                controller: "form", action: "lexxy:file-accept->form#preventAttachment keydown.esc->form#cancel keydown.enter->form#submit:prevent keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent" } do |form| %>
            <div class="nw-composer nw-composer--edit">
              <div class="nw-composer__editor">
                <%= form.rich_text_area :body,
                      value: editable_body(@message),
                      rows: 1,
                      class: "input lexxy-content",
                      aria: { multiline: "true", label: "Edit message" },
                      autofocus: true,
                      "permitted-attachment-types": "application/vnd.campfire.mention application/vnd.actiontext.opengraph-embed",
                      data: { action: rich_text_data_actions } do %>
                  <%= mention_prompt_tag @room %>
                <% end %>
              </div>
            </div>

            <div class="nw-edit__actions">
              <%= button_tag class: "btn btn--negative nw-btn-sm", type: "submit", form: dom_id(@message, :delete_form),
                    data: { turbo_confirm: "Delete this message? This can't be undone.", confirm_label: "Delete message" } do %>
                <%= image_tag "trash.svg" %><span>Delete</span>
              <% end %>
              <span class="nw-small nw-muted nw-grow nw-edit__hint">Esc to cancel · Enter to save</span>
              <%= link_to "Cancel", room_message_path(@room, @message), class: "btn nw-btn-outline nw-btn-sm", data: { form_target: "cancel" } %>
              <%= button_tag "Save", type: "submit", class: "btn btn--reversed nw-btn-sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>


    <%= form_with url: room_message_path(@message.room, @message), method: :delete, id: dom_id(@message, :delete_form), data: { turbo_frame: dom_id(@message, :edit) } %>
  </div>
</turbo-frame>

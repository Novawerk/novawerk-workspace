<% @page_title = "Custom styles" %>
<% page_header "Account settings" %>

<div class="nw-page">
  <div class="nw-page__narrow nw-page__narrow--wide" style="view-transition-name: custom-styles">
    <%= render "accounts/tabs", current: :custom_styles %>

    <div class="nw-card">
      <%= form_with model: @account, url: account_custom_styles_url, data: { controller: "form", action: "keydown.ctrl+enter->form#submit keydown.meta+enter->form#submit" } do |form| %>
        <div class="nw-card__head"><h2 class="nw-card__title">Custom styles</h2><p class="nw-card__desc">CSS added after the chat's own styles, for everyone.</p></div>
        <div class="nw-card__body">
          <p class="nw-alert nw-alert--warn"><%= image_tag "alert.svg" %><span>Careful: a broken rule can hide parts of the chat for everyone. If that happens, open this page and press Reset.</span></p>
          <div class="nw-field">
            <%= form.label :custom_styles, "CSS", class: "nw-label" %>
            <%= form.text_area :custom_styles, class: "input nw-code nw-code--editor", placeholder: "/* Tighter message rows */\n.message {\n  padding-block: 4px;\n}",
                  autocomplete: "off", spellcheck: "false", autocorrect: "off", autocapitalize: "off", rows: 14, required: false %>
          </div>
        </div>
        <div class="nw-card__foot">
          <span class="nw-small nw-muted nw-grow">Applies to everyone as soon as you save.</span>
          <button type="button" class="btn btn--plain" onclick="this.form.querySelector('textarea').value=''">Reset</button>
          <%= form.button "Save styles", type: "submit", class: "btn btn--reversed" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

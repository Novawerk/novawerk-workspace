<div class="nw-bots__row" style="view-transition-name: chat-bot-<%= bot.id %>">
  <span class="nw-bots__avatar"><%= image_tag fresh_user_avatar_path(bot), alt: "", size: 32 %></span>
  <span class="nw-stack nw-grow">
    <span class="nw-bots__name"><%= bot.name %></span>
    <span class="nw-small nw-muted"><% if bot.webhook_url.present? %><%= image_tag "link.svg", size: 12 %> <%= bot.webhook_url %><% else %>No webhook · posts only<% end %></span>
  </span>
  <code class="nw-bots__key"><%= bot.bot_key.to_s.first(5) %>••••••••</code>
  <%= button_to_copy_to_clipboard(bot.bot_key) do %><%= image_tag "copy-paste.svg" %><span>Copy key</span><% end %>
  <%= link_to "Edit", edit_account_bot_path(bot), class: "btn btn--plain nw-btn-sm" %>
</div>

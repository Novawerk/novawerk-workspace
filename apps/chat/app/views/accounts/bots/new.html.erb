<% @page_title = "New chat bot" %>
<% page_header "New bot", crumb: "Bots" %>

<div class="nw-page">
  <div class="nw-page__narrow nw-page__narrow--form">
    <h2 class="nw-h1">New bot</h2>
    <div class="nw-card nw-room-form">
      <%= form_with model: @bot, url: account_bots_path do |form| %>
        <%= render "accounts/bots/form", form: form, bot: @bot %>
      <% end %>
    </div>
  </div>
</div>

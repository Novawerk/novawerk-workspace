<% @page_title = "Account settings" %>
<% page_header "Account settings" %>

<div class="nw-page">
  <div class="nw-page__narrow nw-page__narrow--wide" style="view-transition-name: account-settings">
    <%= render "accounts/tabs", current: :general %>

    <% if Current.user.can_administer? %>
      <div class="nw-card">
        <div class="nw-card__head"><h2 class="nw-card__title">Chat</h2><p class="nw-card__desc">How Novawerk Chat looks to everyone.</p></div>
        <div class="nw-card__body nw-card__body--settings">
          <div class="nw-logo-row" data-controller="upload-preview">
            <span class="nw-logo-tile"><%= image_tag fresh_account_logo_path, alt: "", size: 56, data: { upload_preview_target: "image" } %></span>
            <div class="nw-stack nw-grow"><span class="nw-label">Logo</span><span class="nw-hint">Square PNG, at least 192 px. Used as the app icon.</span></div>
            <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
              <label class="btn nw-btn-outline nw-btn-sm input--file">
                <%= image_tag "upload.svg" %><span>Upload</span>
                <%= form.file_field :logo, class: "input", accept: "image/*", data: { upload_preview_target: "input", action: "upload-preview#previewImage change->form#submit" } %>
              </label>
            <% end %>
            <% if @account.logo.attached? %>
              <%= button_to "Remove", fresh_account_logo_path, method: :delete, class: "btn btn--plain nw-btn-sm" %>
            <% end %>
          </div>

          <%= form_with model: @account, class: "nw-field", data: { controller: "form" } do |form| %>
            <%= form.label :name, "Name", class: "nw-label" %>
            <div class="nw-row nw-row--nowrap">
              <%= form.text_field :name, class: "input nw-input nw-input--name", autocomplete: "off", data: { action: "keydown.enter->form#submit" } %>
              <%= form.button "Save", type: "submit", class: "btn nw-btn-outline" %>
            </div>
          <% end %>

          <div class="nw-sep"></div>

          <%= form_with model: @account, method: :put, data: { controller: "form" }, class: "nw-setting-row" do |form| %>
            <span class="nw-stack nw-grow"><span class="nw-label">Only maintainers can create rooms</span><span class="nw-hint">Members can still start direct messages.</span></span>
            <%= form.fields_for :settings, @account.settings do |settings_form| %>
              <%= settings_form.hidden_field :restrict_room_creation_to_administrators, value: !Current.account.settings.restrict_room_creation_to_administrators? %>
            <% end %>
            <label class="switch">
              <%= tag.input type: "checkbox", class: "switch__input", checked: Current.account.settings.restrict_room_creation_to_administrators?, data: { action: "change->form#submit" } %>
              <span class="switch__btn round"></span>
              <span class="for-screen-reader">Only maintainers can create rooms</span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <% total = User.visible_to(Current.user).without_bots.count %>
    <div class="nw-card" data-controller="nw-filter">
      <div class="nw-card__head nw-card__head--split">
        <div class="nw-stack"><h2 class="nw-card__title">Members</h2>
          <p class="nw-card__desc"><%= pluralize(total, "person", plural: "people") %> · <%= NovawerkSso.configured? ? "they join with their Novawerk account." : "they join with the invite link." %></p></div>
        <label class="input nw-input-group">
          <%= image_tag "search.svg", class: "nw-muted" %>
          <input type="search" placeholder="Search members" aria-label="Search members" data-action="input->nw-filter#filter">
        </label>
      </div>

      <% unless NovawerkSso.configured? %>
        <div class="nw-card__body"><%= render "accounts/invite" %></div>
      <% end %>

      <div class="nw-table" role="table" aria-label="Members">
        <div class="nw-table__head" role="row">
          <span role="columnheader">Person</span><span role="columnheader">Role</span><span role="columnheader">Joined</span><span role="columnheader"><span class="for-screen-reader">Actions</span></span>
        </div>
        <turbo-frame id="account_users" class="nw-table__body">
          <%= render partial: "accounts/users/user", collection: @administrators, as: :user %>
          <%= render partial: "accounts/users/user", collection: @page.records, as: :user %>
          <%= render "accounts/users/next_page_container", page: @page.next_param unless @page.last? %>
        </turbo-frame>
      </div>
    </div>

    <p class="nw-small nw-muted nw-center">Novawerk Chat · based on Campfire&trade; · <%= version_badge %></p>
  </div>
</div>

<li class="nw-members__row <%= "banned" if user.banned? %>">
  <div class="nw-members__person">
    <figure class="avatar flex-item-no-shrink"><%= avatar_tag user, loading: :lazy %></figure>
    <span class="nw-stack">
      <strong><%= link_to user.name, user_path(user), target: "_top" %><%= tag.span(" (you)", class: "nw-muted") if user == Current.user %></strong>
      <%= novawerk_handle_tag(user, class: "nw-small nw-muted") %>
    </span>
  </div>

  <span class="nw-members__role">
    <% if user.banned? %>
      <span class="nw-badge nw-badge--danger">Banned</span>
    <% elsif user.bot? %>
      <span class="nw-badge">Bot</span>
    <% elsif user.administrator? %>
      <span class="nw-badge nw-badge--soft">Maintainer</span>
    <% else %>
      <span class="nw-badge">Member</span>
    <% end %>
  </span>

  <span class="nw-members__actions">
    <% if Current.user.can_administer? && user.active? %>
      <% unless user.bot? || NovawerkSso.configured? %>
        <%# Without Novawerk sign-in, roles are set here; with it they come from the Novawerk account. %>
        <%= form_with model: user, url: account_user_path(user), data: { controller: "form" }, method: :patch do | form | %>
          <label class="btn" for="<%= dom_id(user, :role) %>" title="Toggle maintainer">
            <%= image_tag "crown.svg", alt: "Role: #{user.administrator? ? "Maintainer" : "Member"}" %>
            <%= form.check_box :role, { data: { action: "form#submit" }, hidden: true, id: dom_id(user, :role), disabled: user == Current.user }, "administrator", "member" %>
          </label>
        <% end %>
      <% end %>

      <% unless user == Current.user %>
        <%= button_to account_user_path(user), method: :delete, class: "btn btn--negative", title: "Remove from the chat", data: {
              turbo_confirm: "Remove #{user.name} from the chat for good? This can't be undone.", confirm_label: "Remove #{user.name}" } do %>
          <%= image_tag "trash.svg", alt: "Remove #{user.name}" %>
        <% end %>
      <% end %>
    <% end %>
  </span>
</li>

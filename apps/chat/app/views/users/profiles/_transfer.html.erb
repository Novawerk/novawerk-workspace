<% mine = Current.user == user %>

<div class="nw-card__row nw-transfer">
  <span class="nw-card__icon"><%= image_tag "key.svg" %></span>
  <span class="nw-card__text">
    <strong><%= mine ? "Sign in on another device" : "Sign-in link" %></strong>
    <span class="nw-desktop-only"><%= mine ? "A private one-time link or QR code. Don't share it." : "A private link that signs #{user.name} in on another device. Share it only with them." %></span>
    <span class="nw-phone-only">For <%= mine ? "your" : "#{user.name.split.first}'s" %> other devices</span>
  </span>
  <%= render layout: "users/profiles/sign_in_link_dialog", locals: { user: user } do %>
    <button type="button" class="btn nw-btn-outline nw-btn-sm" data-action="nw-dialog#open"><%= mine ? "Show link…" : "Get link…" %></button>
  <% end %>
</div>

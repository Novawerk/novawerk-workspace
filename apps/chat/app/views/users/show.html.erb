<% @page_title = @user.name %>
<% page_header @user.name do %>
  <% if Current.user == @user %>
    <%= link_to user_profile_path, class: "btn btn--plain" do %>
      <%= image_tag "pencil.svg" %><span>My profile</span>
    <% end %>
  <% end %>
<% end %>

<div class="nw-page">
  <div class="nw-page__narrow <%= "banned" if @user.banned? %>">
    <div class="nw-profile">
      <span class="avatar nw-profile__avatar"><%= image_tag fresh_user_avatar_path(@user), alt: "", size: 88 %></span>

      <div class="nw-profile__body">
        <div class="nw-row">
          <h2 class="nw-h1"><%= @user.name %></h2>
          <% if @user.bot? %>
            <span class="nw-badge">Bot</span>
          <% elsif @user.administrator? %>
            <span class="nw-badge nw-badge--soft">Maintainer</span>
          <% else %>
            <span class="nw-badge">Member</span>
          <% end %>
          <% if @user.banned? %><span class="nw-badge nw-badge--danger">Banned</span><% end %>
        </div>

        <% if @user.deactivated? %>
          <p class="nw-muted"><%= @user.name %> is no longer on this account.</p>
        <% else %>
          <%= novawerk_handle_tag @user %>
          <% if @user.bio.present? %><p class="nw-profile__bio"><%= @user.bio %></p><% end %>
          <%= novawerk_public_profile_tag @user %>

          <% if @user.active? && Current.user != @user %>
            <div class="nw-row nw-profile__actions">
              <%= button_to rooms_directs_path(user_ids: [ @user.id ]), class: "btn btn--reversed" do %>
                <%= image_tag "messages.svg" %><span>Message</span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if Current.user.can_administer? && !@user.bot? && !@user.deactivated? %>
      <div class="nw-divider-label"><span>Maintainer only</span></div>

      <div class="nw-card nw-card--rows">
        <div class="nw-card__row">
          <span class="nw-card__icon"><%= image_tag "email.svg" %></span>
          <div class="nw-card__text"><strong>Email</strong><span><%= mail_to @user.email_address %></span></div>
          <%= button_to_copy_to_clipboard(@user.email_address) do %><span>Copy</span><% end %>
        </div>

        <% if @user.active? %>
          <%= render "users/profiles/transfer", user: @user %>
        <% end %>

        <% if Current.user != @user %>
          <div class="nw-card__row">
            <span class="nw-card__icon nw-card__icon--danger"><%= image_tag "cancel.svg" %></span>
            <div class="nw-card__text">
              <strong><%= @user.banned? ? "Banned from the chat" : "Ban from the chat" %></strong>
              <span><%= @user.banned? ? "Lift the ban to let #{@user.name} back in." : "Signs #{@user.name} out, deletes their messages and blocks their IP addresses." %></span>
            </div>
            <%= render "users/ban_button", user: @user %>
          </div>
        <% end %>
      </div>

      <p class="nw-hint nw-row"><%= image_tag "lock.svg" %>Roles (Maintainer, Member) come from the Novawerk account. Change them in the admin panel.</p>
    <% end %>
  </div>
</div>

<% @page_title = "Sign in" %>
<% turbo_page_requires_reload %>

<section class="nw-signin">
  <div class="nw-card nw-signin__card <%= "shake" if flash[:alert] %>">
    <span class="nw-signin__logo"><%= image_tag fresh_account_logo_path, alt: "", size: 32 %></span>

    <% if NovawerkSso.configured? %>
      <div class="nw-signin__text">
        <h1 class="nw-signin__title">Sign in to Novawerk Chat</h1>
        <p class="nw-muted">One Novawerk account for the site, the admin panel and the chat.</p>
      </div>

      <% if params[:problem] == "banned" %>
        <p class="nw-alert nw-alert--danger" role="alert"><%= image_tag "cancel.svg" %><span>This account can't use the chat.</span></p>
      <% elsif params[:problem] %>
        <p class="nw-alert nw-alert--danger" role="alert"><%= image_tag "alert.svg" %><span>That sign-in didn't work. Please try again.</span></p>
      <% elsif params[:signed_out] %>
        <p class="nw-alert"><%= image_tag "circle-check.svg" %><span>You signed out of the chat.</span></p>
      <% end %>

      <%= link_to NovawerkSso.sign_in_url, class: "btn btn--reversed nw-btn-block" do %>
        <%= image_tag "star.svg" %><span>Sign in with Novawerk</span>
      <% end %>
      <p class="nw-small nw-muted">No account yet? <%= link_to "Join on novawerk.io", NovawerkSso.web_url %></p>
    <% else %>
      <h1 class="nw-signin__title"><%= Current.account&.name || "Novawerk" %></h1>
      <%= form_with url: session_url, class: "nw-form" do |form| %>
        <div class="nw-field">
          <%= form.label :email_address, "Email", class: "nw-label" %>
          <%= form.email_field :email_address, required: true, class: "input", autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address] %>
        </div>
        <div class="nw-field">
          <%= form.label :password, "Password", class: "nw-label" %>
          <%= form.password_field :password, required: true, class: "input", autocomplete: "current-password", maxlength: 72 %>
        </div>
        <%= form.button "Sign in", class: "btn btn--reversed nw-btn-block", type: "submit", name: "log_in" %>
      <% end %>
    <% end %>
  </div>

  <% if Current.account %>
    <%= render "accounts/help_contact" %>
  <% end %>
</section>

# apps/admin — copy to .env.local and fill in. Only VITE_* names reach the browser.

# Base URL of apps/api. Defaults to http://localhost:8787 when unset.
VITE_API_URL=

# The public website: sign-in, settings, profiles and tasks. Defaults to https://novawerk.io.
VITE_WEB_URL=

# Sample-data mode: every screen renders built-in fictional data, kept in memory, and skips the
# API sign-in check. Off unless set to "true". Handy for UI work without apps/api.
VITE_USE_SAMPLE_DATA=

# owner/repo of the agents' GitHub Actions workflows (the Agents page links there).
# Defaults to Novawerk/novawerk.
VITE_GITHUB_REPOSITORY=

# Local development only: an email sign-in on /login that calls POST {API}/auth/dev.
# Needs the API to run with DEV_LOGIN=true. Ignored in production builds.
VITE_DEV_LOGIN=
# Prefilled on /login. The seed has maintainer@example.com (maintainer) and mara@example.com (member).
VITE_DEV_LOGIN_EMAIL=
